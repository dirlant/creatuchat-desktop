{
  "name": "creatuchat-desktop",
  "productName": "Creatuchat",
  "version": "0.1.10",
  "description": "Creatuchat: WhatsApp Web con envíos automáticos y asistente con IA, como aplicación de escritorio.",
  "main": "main.js",
  "author": "Creatuchat",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.creatuchat.desktop",
    "productName": "Creatuchat",
    "files": [
      "main.js",
      "preload.js",
      "ext/**/*",
      "ventanas/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Creatuchat",
      "artifactName": "Creatuchat-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dirlant",
        "repo": "creatuchat-desktop",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": "-",
      "artifactName": "Creatuchat-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Creatuchat ${version}"
    }
  }
}
